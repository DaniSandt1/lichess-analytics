# Copien este archivo como .env (cp .env.ejemplo .env). El .env NO se sube a git.
# Estos valores sirven para trabajar desde su laptop (localhost).
# Dentro del contenedor de Airflow, docker-compose.yml cambia los hosts por mongo, cassandra y neo4j.

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DB=lichess

# --- Cassandra ---
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=lichess

# --- Neo4j (la contraseña debe tener al menos 8 caracteres) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lichess123

# --- Airflow (usuario de la interfaz web en http://localhost:8080) ---
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
# Si el 8080 ya está ocupado en tu PC ("port is already allocated"), cámbialo, por ejemplo a 8081
AIRFLOW_PORT=8080

# --- API de Lichess ---
# Sin User-Agent propio, Lichess responde 404. Pueden agregar un correo del grupo al final.
LICHESS_USER_AGENT=proyecto-bigdata-utec-lichess/1.0
# Opcional: token personal de https://lichess.org/account/oauth/token (sin permisos marcados).
# Sube el límite de descarga de 20 a 30 partidas por segundo.
LICHESS_TOKEN=
